{
  "expo": {
    "name": "Klipp",
    "slug": "klipp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/klipp-icon.png",
    "scheme": "klipp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/klipp-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F5F0",
        "foregroundImage": "./assets/images/klipp-symbol.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/klipp-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Klipp usa tu ubicación para encontrar profesionales cercanos y compartirla durante un servicio en camino.",
          "locationAlwaysAndWhenInUsePermission": "Klipp comparte tu ubicación en segundo plano solo mientras estás en camino a un servicio reservado.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F5F0",
          "image": "./assets/images/klipp-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "klipp-updates"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/Klipp"
    }
  }
}
